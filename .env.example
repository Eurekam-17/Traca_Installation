# Variables d'environnement reconnues par drugcam-traca.
# Copier ce fichier en `.env` (ignoré par Git) et remplir les valeurs locales,
# OU exporter manuellement ces variables avant de lancer l'application.
#
# Aucune de ces variables n'est obligatoire — elles surchargent uniquement
# les défauts définis dans src/config.py.

# ---------------------------------------------------------------------------
# Choix d'environnement Odoo
# ---------------------------------------------------------------------------
# Profils disponibles : staging | prod
# Par défaut : staging (sécurité — évite les écritures accidentelles en prod).
# Surchargeable aussi via l'argument CLI : --env prod
DRUGCAM_TRACA_ENV=staging

# ---------------------------------------------------------------------------
# Mode mock — aucune écriture Odoo réelle (utile pour démo/dev/CI)
# ---------------------------------------------------------------------------
# DRUGCAM_TRACA_DRY_RUN=1

# ---------------------------------------------------------------------------
# Clé API du compte de service traca-bot@eurekam.fr
# ---------------------------------------------------------------------------
# Si non définie, l'application demandera la clé via une boîte de dialogue Qt
# au premier lancement, puis la sauvegardera dans
# ~/.drugcam-traca/credentials.<profile>.json (perms 600).
# DRUGCAM_TRACA_API_KEY=remplacer-par-la-vraie-cle-ne-jamais-commiter

# ---------------------------------------------------------------------------
# Surcharges fines (optionnelles, pour cas particuliers)
# ---------------------------------------------------------------------------
# Si laissées vides, elles sont déduites du profil DRUGCAM_TRACA_ENV.
# DRUGCAM_TRACA_ODOO_HOST=eurekam-staging-28517368.dev.odoo.com
# DRUGCAM_TRACA_ODOO_DB=eurekam-staging-28517368
# DRUGCAM_TRACA_ODOO_LOGIN=traca-bot@eurekam.fr
# DRUGCAM_TRACA_ODOO_PROTOCOL=jsonrpc+ssl
# DRUGCAM_TRACA_ODOO_PORT=443

# ---------------------------------------------------------------------------
# Noms techniques des modèles Odoo (avancé)
# ---------------------------------------------------------------------------
# DRUGCAM_TRACA_MODEL_POSTE=customer.asset.workstation
# DRUGCAM_TRACA_MODEL_TRACABILITE=x_customer_asset_installation_log
